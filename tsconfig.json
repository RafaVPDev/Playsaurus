{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "compartilhado/**/*.ts",
    "config/**/*.ts",
    "extras/**/*.ts",
    "projetos/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "projetos/**/output",
    "projetos/**/.playsaurus"
  ]
}
